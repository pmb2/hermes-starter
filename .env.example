# =============================================================================
# Hermes Starter Kit — Environment Configuration
# =============================================================================
# Copy to your Hermes home as `.env` and fill in YOUR values.
#   Windows: ~/AppData/Local/hermes/.env
#   Linux/macOS: ~/.hermes/.env
# Never commit real secrets. This template has zero values.
# =============================================================================

# ── Model Provider ───────────────────────────────────────────────────────────
# Pick at least ONE. The example config.yaml routes model.provider accordingly.
OPENROUTER_API_KEY=sk-or-your-key-here
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# GOOGLE_API_KEY=

# OmniRoute-style local router (if you run one — see config.yaml model.base_url)
# CUSTOM_PROVIDER_OMNIROUTE_KEY=

# ── Discord Gateway ──────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=your-discord-bot-token
# Home channel for scheduled / undirected messages (from step 6):
DISCORD_HOME_CHANNEL=your-home-channel-id
DISCORD_HOME_CHANNEL_THREAD_ID=
# Optional: restrict which channels the bot watches (comma-separated ids)
# DISCORD_ALLOWED_CHANNELS=
# Optional: restrict which users may trigger the bot (comma-separated ids)
# DISCORD_ALLOWED_USERS=

# ── API Server (optional, for the /api_server platform) ─────────────────────
API_SERVER_KEY=generate-a-long-random-string

# ── Optional Tools & Services ────────────────────────────────────────────────
# GitHub token (github skills, repo management)
# GITHUB_TOKEN=ghp_your-token-here

# Postgres (postgres MCP server in config.yaml)
# POSTGRES_CONNECTION_STRING=postgresql://user:password@localhost:5432/db

# Gmail (for IMAP/mail watchdogs — use an App Password, not your password)
# GMAIL_SENDER_EMAIL=you@gmail.com
# GMAIL_APP_PASSWORD=your-16-char-app-password

# Buzz bridge (Nostr relay) — see gateway/buzz.md
# BUZZ_RELAY_URL=ws://localhost:3000

# Browser automation backends (optional)
# CAMOFOX_URL=
# BROWSERBASE_API_KEY=
# FIRECRAWL_API_KEY=

# ── TTS / STT (optional) ─────────────────────────────────────────────────────
# ELEVENLABS_API_KEY=
# MISTRAL_API_KEY=
# GROQ_API_KEY=